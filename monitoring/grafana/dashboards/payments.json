{
  "title": "Payments",
  "uid": "payments-overview",
  "timezone": "browser",
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "type": "stat", "title": "Transfers (1h)",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [{"expr": "sum(increase(transfers_total[1h]))", "legendFormat": "total"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}
    },
    {
      "type": "stat", "title": "Oldest PENDING (s)",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [{"expr": "oldest_pending_age_seconds", "legendFormat": "oldest pending"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null},
        {"color": "yellow", "value": 60},
        {"color": "red", "value": 300}
      ]}}}
    },
    {
      "type": "stat", "title": "DLQ (5m)",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
            "targets": [{"expr": "rabbitmq_queue_messages_ready{queue=\"transfers.dlq\"}", "legendFormat": "dlq"}],
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"thresholds": {"steps": [
        {"color": "green", "value": null},
        {"color": "red", "value": 1}
      ]}}}
    },
    {
      "type": "timeseries", "title": "Transfers by status",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [{"expr": "sum by (status) (increase(transfers_total[5m]))", "legendFormat": "{{status}}"}]
    },
    {
      "type": "timeseries", "title": "api up / worker up",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"expr": "up{job=\"api\"}", "legendFormat": "api"},
        {"expr": "up{job=\"worker\"}", "legendFormat": "worker"}
      ]
    },
    {
      "type": "logs", "title": "Logs (api/worker) — request_id",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 14},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [{"expr": "{job=\"docker\", service_name=~\"payment-stack-(api|worker).*\"}"}]
    }
  ]
}